---
// src/components/PlayfollyFooter.astro
interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;
const isHome = currentPath === '/' || currentPath === '';
---

<footer class="playfolly-footer" id="baraatFooter" aria-label="Footer and cultural archive">
  <!-- Warm ambient backlight -->
  <div class="footer-backdrop" aria-hidden="true">
    <div class="footer-ambient-radial"></div>
  </div>

  <!-- Top Region: Action Pills, SEO Narrative & Quick Directory -->
  <div class="footer-top-row">
    <!-- Left Column: Action Pills & SEO Narrative -->
    <div class="footer-left-col">
      <div class="footer-pill-row">
        <a
          href="https://instagram.com/shadikibaraat"
          target="_blank"
          rel="noopener noreferrer"
          class="footer-pill footer-pill-white"
          aria-label="Visit Shadi Ki Baraat on Instagram"
        >
          <svg class="pill-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
          <span>@shadikibaraat</span>
        </a>
        <a
          href="mailto:hello@shadikibaraat.com?subject=Baraat%20Story"
          class="footer-pill footer-pill-white"
          aria-label="Send an email to Shadi Ki Baraat"
        >
          <svg class="pill-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
          </svg>
          <span>Email us</span>
        </a>
        <button
          type="button"
          class="footer-pill footer-pill-dark"
          id="footerShareBtn"
        >
          <svg class="pill-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 12v7a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-7"></path>
            <path d="M12 3v12"></path>
            <path d="m7 8 5-5 5 5"></path>
          </svg>
          <span id="footerShareLabel" aria-live="polite">Share</span>
        </button>
      </div>

      <div class="footer-seo-summary">
        <h3 class="footer-seo-heading">Your Baraat Playlist, From Groom Entry to Afterparty</h3>
        <p class="footer-statement">
          Find the soundtrack for every moment of the baraat, from the <a href="/baraat-entry-songs-for-groom/">groom's entry</a> and dhol-led dancing to the DJ set and afterparty. Explore curated Hindi wedding songs through a playful, ad-free website interface. You can <a href="/playlists/">explore baraat playlists in Hindi</a> or <a href="/songs/">browse the baraat songs list</a>, discover <a href="/old-hindi-baraat-songs/">old Hindi and 90s baraat songs</a>, find <a href="/baraat-songs-for-wedding-video/">baraat songs for wedding videos</a>, and learn <a href="/baraat-meaning/">what is a baraat</a>.
        </p>
      </div>
    </div>

    <!-- Right Column: Return Button & Structured Link Directory -->
    <div class="footer-right-col">
      <div class="footer-return-wrap">
        <button
          type="button"
          class="footer-return-btn"
          id="footerReturnBtn"
          data-is-home={isHome ? "true" : "false"}
          aria-label="Return to Baraat"
        >
          <span>Return to Baraat</span>
        </button>
      </div>

      <nav class="footer-directory" aria-label="Footer quick links">
        <div class="directory-row">
          <a href="/playlists/" class="directory-link">7 Rotations</a>
          <a href="/songs/" class="directory-link">140 Songs</a>
          <a href="/baraat-entry-songs-for-groom/" class="directory-link">Groom Entry</a>
          <a href="/old-hindi-baraat-songs/" class="directory-link">Old Hindi</a>
        </div>
        <div class="directory-row">
          <a href="/baraat-songs-for-wedding-video/" class="directory-link">Wedding Video</a>
          <a href="/baraat-meaning/" class="directory-link">Baraat Meaning</a>
          <button type="button" class="directory-link directory-link--button" data-consent-open>Cookie choices</button>
        </div>
      </nav>
    </div>
  </div>

  <!-- Procession art, feathered into the glow, between the text and the title -->
  <div class="footer-center-scene" aria-hidden="true">
    <img
      src="/assets/phase-nikli.webp"
      alt=""
      class="footer-center-img"
      width="1672"
      height="941"
      loading="lazy"
      decoding="async"
    />
  </div>

  <!-- Bottom Monumental Typography -->
  <div class="footer-bottom-strap">
    <h2 class="footer-huge-title">Shadi ki baraat</h2>
  </div>
</footer>

<script>
  // Handle Return to Baraat action
  const returnBtn = document.getElementById('footerReturnBtn');
  if (returnBtn) {
    returnBtn.addEventListener('click', () => {
      const isHome = returnBtn.getAttribute('data-is-home') === 'true' || window.location.pathname === '/';
      if (isHome) {
        if ((window as any).__lenis) {
          (window as any).__lenis.scrollTo(0, { duration: 1.2 });
        } else {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      } else {
        window.location.href = '/';
      }
    });
  }

  // Share: native share sheet on phones, copy-link fallback elsewhere.
  const shareBtn = document.getElementById('footerShareBtn');
  const shareLabel = document.getElementById('footerShareLabel');
  let shareTimer: ReturnType<typeof setTimeout> | undefined;
  shareBtn?.addEventListener('click', async () => {
    const url = location.href;
    if (navigator.share) {
      try { await navigator.share({ title: document.title, url }); } catch { /* dismissed */ }
      return;
    }
    try {
      await navigator.clipboard.writeText(url);
      if (!shareLabel) return;
      shareLabel.textContent = 'Link copied';
      clearTimeout(shareTimer);
      shareTimer = setTimeout(() => { shareLabel.textContent = 'Share'; }, 2000);
    } catch { /* clipboard blocked: leave the button as is */ }
  });
</script>

<style>
  .playfolly-footer {
    --ink: #f7efd8;
    position: relative;
    width: 100%;
    margin-top: 0;
    padding: clamp(40px, 6vw, 68px) clamp(24px, 5vw, 56px) 0;
    box-sizing: border-box;
    background: #140704;
    overflow: hidden;
    color: var(--ink);
    display: flex;
    flex-direction: column;
    border-top: 1px solid rgba(247, 239, 216, 0.08);
  }

  /* Backdrop: Ambient Radial Glow & Centered Celebration Artwork */
  .footer-backdrop {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  /* Warm glow, weighted right of centre so the art sits in the light, as in the reference. */
  .footer-ambient-radial {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 55% 60% at 62% 42%, rgba(255, 110, 30, 0.42) 0%, rgba(212, 70, 16, 0.2) 45%, transparent 80%),
      radial-gradient(ellipse 80% 70% at 30% 20%, rgba(150, 60, 20, 0.28) 0%, transparent 70%),
      linear-gradient(180deg, rgba(20, 7, 4, 0) 55%, #140704 100%);
  }

  /* In flow between the text and the title, so it never sits under either. Every edge dissolves into the glow. */
  .footer-center-scene {
    position: relative;
    z-index: 1;
    align-self: center;
    width: min(1040px, 72vw);
    aspect-ratio: 16 / 9;
    margin-top: clamp(-120px, -8vw, -40px);
    pointer-events: none;
    mask-image: radial-gradient(ellipse 50% 50% at 50% 50%, #000 45%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 50% 50% at 50% 50%, #000 45%, transparent 100%);
  }

  .footer-center-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 60%;
    filter: saturate(0.78) sepia(0.12) contrast(1.05) brightness(0.94);
  }

  /* Top Content Layout: 2 Columns Across Desktop */
  .footer-top-row {
    position: relative;
    z-index: 3;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 40px;
    width: 100%;
  }

  /* Left Column: Action Pills & SEO Narrative */
  .footer-left-col {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 460px;
  }

  .footer-pill-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  .footer-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 18px;
    border-radius: 9999px;
    font-family: 'Satoshi', sans-serif;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
    border: none;
    transition: transform 0.2s ease, opacity 0.2s ease, background 0.2s ease;
  }

  .footer-pill:hover {
    transform: translateY(-2px);
  }

  .footer-pill-white {
    background: var(--ink);
    color: #120703;
  }

  .footer-pill-white:hover {
    opacity: 0.94;
  }

  .footer-pill-dark {
    background: rgba(247, 239, 216, 0.16);
    color: var(--ink);
    border: 1px solid rgba(247, 239, 216, 0.32);
  }

  .footer-pill-dark:hover {
    background: rgba(247, 239, 216, 0.24);
  }

  .pill-icon {
    width: 14px;
    height: 14px;
    display: inline-block;
    flex-shrink: 0;
  }

  .footer-seo-summary {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .footer-seo-heading {
    font-family: 'Satoshi', sans-serif;
    font-size: 15px;
    font-weight: 700;
    color: #ffb885;
    margin: 0;
    letter-spacing: -0.01em;
  }

  .footer-statement {
    font-family: 'Satoshi', sans-serif;
    font-size: 13px;
    line-height: 1.55;
    color: rgba(247, 239, 216, 0.88);
    margin: 0;
  }

  .footer-statement a {
    color: #ffb885;
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.18s ease;
  }

  .footer-statement a:hover {
    color: var(--ink);
  }

  /* Right Column: Return to Baraat & Clean 2-Row Directory */
  .footer-right-col {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 18px;
    text-align: right;
  }

  .footer-return-btn {
    display: inline-flex;
    align-items: center;
    padding: 10px 22px;
    border-radius: 9999px;
    background: rgba(247, 239, 216, 0.16);
    color: var(--ink);
    border: 1px solid rgba(247, 239, 216, 0.32);
    font-family: 'Satoshi', sans-serif;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .footer-return-btn:hover {
    background: rgba(247, 239, 216, 0.26);
    transform: translateY(-2px);
  }

  .footer-directory {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
  }

  .directory-row {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .directory-link {
    font-family: 'Satoshi', sans-serif;
    font-size: 13px;
    font-weight: 500;
    color: rgba(247, 239, 216, 0.82);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.18s ease;
  }

  .directory-link:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  .directory-link--button {
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
  }

  /* Monumental Base Strap */
  .footer-bottom-strap {
    position: relative;
    z-index: 3;
    width: 100%;
    margin: clamp(-90px, -6vw, -24px) 0 0;
    padding: 0;
    overflow: visible;
    line-height: 0.95;
    user-select: none;
    pointer-events: none;
    display: flex;
    justify-content: center;
    align-items: flex-end;
  }

  .footer-huge-title {
    font-family: 'Satoshi', var(--font-display);
    font-weight: 900;
    font-size: clamp(48px, 13.8vw, 220px);
    line-height: 0.8;
    letter-spacing: -0.04em;
    text-transform: none;
    color: var(--ink);
    margin: 0;
    padding: 0;
    /* Baseline sits on the footer's bottom edge. */
    transform: translateY(0.02em);
    white-space: nowrap;
    display: block;
    box-sizing: border-box;
    width: 100%;
    text-align: center;
  }

  /* Pages with a fixed bottom player (/songs, /playlists): keep the title clear of it. */
  :global(body:has(.player-dock-wrap)) .playfolly-footer {
    padding-bottom: var(--dock-clearance, 128px);
  }

  /* Mobile Responsive Refinements */
  @media (max-width: 860px) {
    .playfolly-footer {
      padding: 32px 18px env(safe-area-inset-bottom, 0px);
    }

    .footer-center-scene {
      width: calc(100% + 36px);
      margin: 8px -18px 0;
      aspect-ratio: 4 / 3;
      align-self: stretch;
      mask-image: radial-gradient(ellipse 55% 50% at 50% 50%, #000 40%, transparent 100%);
      -webkit-mask-image: radial-gradient(ellipse 55% 50% at 50% 50%, #000 40%, transparent 100%);
    }

    .footer-top-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
    }

    .footer-left-col {
      max-width: 100%;
    }

    .footer-right-col {
      align-items: flex-start;
      text-align: left;
      width: 100%;
      gap: 16px;
    }

    .footer-directory {
      align-items: flex-start;
      width: 100%;
    }

    .directory-row {
      justify-content: flex-start;
      gap: 14px 18px;
    }

    .footer-bottom-strap {
      margin-top: -10vw;
    }

    .footer-huge-title {
      font-size: 12.8vw;
      letter-spacing: -0.035em;
    }
  }
</style>
