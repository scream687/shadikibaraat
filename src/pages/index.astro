---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import PlayfollyFooter from '../components/PlayfollyFooter.astro';
import songsData from '../data/songs.json';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://shadikibaraat.com/#website",
      "url": "https://shadikibaraat.com/",
      "name": "Shadi Ki Baraat",
      "description": "Ad-free Baraat playlists and curated Hindi wedding procession songs across seven phases.",
      "publisher": {
        "@id": "https://shadikibaraat.com/#organization"
      }
    },
    {
      "@type": "Organization",
      "@id": "https://shadikibaraat.com/#organization",
      "name": "Shadi Ki Baraat",
      "url": "https://shadikibaraat.com/",
      "logo": "https://shadikibaraat.com/assets/logo-white.png"
    }
  ]
};
---

<BaseLayout
  title="Shadi Ki Baraat | Ad-Free Baraat Playlists & Wedding Songs"
  description="Explore curated Hindi baraat playlists, groom entry songs, old Bollywood favourites and 7 phases of an Indian wedding procession. Find the music for every baraat moment."
  canonicalURL="https://shadikibaraat.com/"
  ogImage="/og/og-home.jpg"
  jsonLd={jsonLd}
>
  <link rel="preload" as="image" href="/assets/01-baraat-wide.png" slot="head" />
  <link rel="preload" as="image" href="/assets/02-baraat-wide.png" fetchpriority="high" slot="head" />
  <link rel="preload" as="image" href="/assets/03-baraat-wide.png" slot="head" />
  <link rel="preload" as="image" href="/assets/04-baraat-wide.png" slot="head" />
  <link rel="preload" as="image" href="/assets/05-baraat-wide.png" slot="head" />
  <link rel="preload" as="image" href="/assets/06-baraat-wide.png" slot="head" />
  <link rel="preload" as="image" href="/assets/07-baraat-wide.png" slot="head" />
  <script is:inline src="https://www.youtube.com/iframe_api"></script>

  <div class="app" id="app">
    <!-- Scene Stack with 7 Procession Artworks -->
    <div class="scene-stack" aria-hidden="true" id="sceneStack">
      <img class="scene-image" id="scene-0" src="/assets/01-baraat-wide.png" alt="" style="object-position: center 36%;" />
      <img class="scene-image is-active" id="scene-1" src="/assets/02-baraat-wide.png" alt="" fetchpriority="high" style="object-position: center 36%;" />
      <img class="scene-image" id="scene-2" src="/assets/03-baraat-wide.png" alt="" style="object-position: center 36%;" />
      <img class="scene-image" id="scene-3" src="/assets/04-baraat-wide.png" alt="" style="object-position: center 36%;" />
      <img class="scene-image" id="scene-4" src="/assets/05-baraat-wide.png" alt="" style="object-position: center 36%;" />
      <img class="scene-image" id="scene-5" src="/assets/06-baraat-wide.png" alt="" style="object-position: center 36%;" />
      <img class="scene-image" id="scene-6" src="/assets/07-baraat-wide.png" alt="" style="object-position: center 36%;" />
    </div>
    <div class="scene-wash"></div>
    <div class="vignette"></div>
    <div class="grain"></div>

    <!-- Deluxe Saloon Top Header -->
    <header class="site-header">
      <div class="header-time" id="headerTime">--:--</div>
      <div class="live-pill" id="livePill" title="Live visitors enjoying the baraat">
        <span class="live-dot"></span>
        <span class="live-count" id="liveCount">148</span>
        <span class="live-label">visitors</span>
      </div>
      <div class="header-actions">
        <button class="icon-button" id="headerPlayBtn" type="button" aria-label="Play soundtrack" title="Play soundtrack">
          <svg class="mini-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/></svg>
        </button>
        <button class="icon-button" id="moodBtn" type="button" aria-pressed="false" aria-label="Toggle lights" title="Toggle lights">
          <svg class="mini-icon" id="moodIcon" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5"/><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </button>
        <button class="icon-button" id="zenBtn" type="button" aria-label="Toggle scene view" title="Toggle scene view">
          <svg class="mini-icon" viewBox="0 0 24 24" fill="none"><path d="M4 8V4m0 0h4M4 4l5 5m11-5h-4m4 0v4m0-4l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button class="icon-button" id="menuBtn" type="button" aria-label="Open menu" aria-haspopup="dialog" title="Open menu">
          <svg class="mini-icon" viewBox="0 0 24 24" fill="none"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </button>
      </div>
    </header>

    <main id="top">
      <!-- Centered Brand Logo (Shadi Ki Baraat) -->
      <div class="hero-logo-wrap">
        <img src="/assets/logo-white.webp" alt="शादी Ki बारात" class="hero-logo-img" width="923" height="603" fetchpriority="high" />
      </div>

      <!-- Left Dock: Sleek Story & Phase Display -->
      <div class="bottom-left-dock">
        <section class="story-block" aria-live="polite" aria-atomic="true">
          <h1 class="sr-only">Your Baraat Playlist, From Groom Entry to Afterparty</h1>
          <p class="kicker" id="phaseKicker">PHASE 02 · DUSK · 6:30 PM</p>
          <p class="story-headline" id="phaseHeadline">Baraat nikli.</p>
          <p class="story-body" id="phaseBody">The gate opens, the band strikes up, and a 12-minute journey immediately becomes a matter of family honour.</p>
        </section>

        <div class="music-card" id="musicCard">
          <!-- Circular Spinning Album / Vinyl Cover -->
          <div class="vinyl-wrap" id="vinylWrap" title="Click to watch full music video">
            <div class="vinyl-disc" id="vinylDisc">
              <img class="vinyl-cover" id="trackCoverImg" src="https://img.youtube.com/vi/jCEdTq3j-0U/hqdefault.jpg" alt="Album artwork" />
            </div>
            <div class="vinyl-spindle" aria-hidden="true"></div>
          </div>

          <!-- Track Meta & Progress Scrubber -->
          <div class="player-center">
            <div class="track-title" id="trackTitle">Gallan Goodiyaan</div>
            <div class="track-artist" id="trackArtist">Shankar Mahadevan · Sukhwinder Singh</div>
            
            <div class="progress-wrap" id="progressWrap" role="slider" aria-label="Seek track" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
              <div class="progress-track">
                <div class="progress-fill" id="trackProgressBar"></div>
                <div class="progress-handle" id="trackProgressHandle"></div>
              </div>
            </div>
            <div class="time-display" id="trackTimeDisplay">0:00 / 0:00</div>
          </div>

          <!-- Playback Controls Cluster on Right -->
          <div class="player-controls">
            <button class="player-ctrl-btn" id="prevTrack" type="button" aria-label="Previous track" title="Previous track">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/></svg>
            </button>
            <button class="player-play-btn" id="playVideo" type="button" aria-label="Play / Pause soundtrack" title="Play / Pause soundtrack">
              <svg id="playIconSvg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
            </button>
            <button class="player-ctrl-btn" id="nextTrack" type="button" aria-label="Next track" title="Next track">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16 6h2v12h-2zm-2 6L5.5 6v12z"/></svg>
            </button>
            <button class="player-watch-btn" id="watchYtBtn" type="button" aria-label="Watch video" title="Watch full music video">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.58 7.19a2.5 2.5 0 0 0-1.76-1.77C18.26 5 12 5 12 5s-6.26 0-7.82.42A2.5 2.5 0 0 0 2.42 7.19 26.07 26.07 0 0 0 2 12a26.07 26.07 0 0 0 .42 4.81 2.5 2.5 0 0 0 1.76 1.77C5.74 19 12 19 12 19s6.26 0 7.82-.42a2.5 2.5 0 0 0 1.76-1.77A26.07 26.07 0 0 0 22 12a26.07 26.07 0 0 0-.42-4.81zM9.75 15.02V8.98L15 12l-5.25 3.02z"/></svg>
              <span>Watch</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Desktop Bottom-Right Dock -->
      <div class="bottom-right-dock">
        <div class="bottom-right-subbar">
          <nav class="dock-nav-chips" aria-label="Quick Navigation">
            <a href="/" class="dock-chip active">Baraat</a>
            <a href="/playlists" class="dock-chip">Playlists</a>
            <a href="/songs" class="dock-chip">Songs (140)</a>
            <a href="/baraat-meaning" class="dock-chip">Meaning</a>
            <a href="#baraatFooter" class="dock-chip" id="dockAboutChip">About</a>
          </nav>
          <button class="reset-pill-inline" id="quickResetBtn" type="button" title="Restart experience">↻ Start Over</button>
        </div>
        <div class="timeline">
          <div class="timeline-topline"><span>THE NIGHT, IN SEVEN STOPS</span><span>Pick a moment</span></div>
          <div class="timeline-items" id="timelineItems" role="tablist" aria-label="Baraat phases"></div>
        </div>
      </div>

      <!-- Mobile Low-Density Floating Dock -->
      <div class="mobile-dock" id="mobileDock">
        <div class="mobile-timeline-bar" id="mobileTimelineBar">
          <div class="mobile-timeline-track" id="mobileDots" role="tablist" aria-label="Baraat phases"></div>
        </div>
        <div class="mobile-bar" id="mobileBar">
          <!-- Mobile Spinning Vinyl Cover -->
          <div class="vinyl-wrap mobile-vinyl" id="mVinylWrap" title="Click to view full video">
            <div class="vinyl-disc" id="mVinylDisc">
              <img class="vinyl-cover" id="mTrackCoverImg" src="https://img.youtube.com/vi/jCEdTq3j-0U/hqdefault.jpg" alt="Album Cover" />
            </div>
            <div class="vinyl-spindle" aria-hidden="true"></div>
          </div>

          <!-- Mobile Center Meta & Progress -->
          <div class="mobile-player-center" id="mTrackInfo">
            <div class="mobile-track-title" id="mTrackTitle">Gallan Goodiyaan</div>
            <div class="mobile-phase-meta" id="mPhaseMeta">Shankar Mahadevan · Sukhwinder Singh</div>
            <div class="progress-wrap mobile-progress" id="mProgressWrap" role="slider" aria-label="Seek track">
              <div class="progress-track">
                <div class="progress-fill" id="mTrackProgressBar"></div>
              </div>
            </div>
            <div class="time-display mobile-time" id="mTrackTimeDisplay">0:00 / 0:00</div>
          </div>

          <!-- Mobile Controls on Right -->
          <div class="mobile-player-controls">
            <button class="mobile-ctrl-btn" id="mPrevTrack" type="button" aria-label="Previous track" title="Previous track">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/></svg>
            </button>
            <button class="mobile-play-btn" id="mPlayTrack" type="button" aria-label="Play song" title="Play song">
              <svg id="mPlayIconSvg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            </button>
            <button class="mobile-ctrl-btn" id="mNextTrack" type="button" aria-label="Next track" title="Next track">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M16 6h2v12h-2zm-2 6L5.5 6v12z"/></svg>
            </button>
            <button class="mobile-ctrl-btn" id="mWatchYtBtn" type="button" aria-label="Watch video" title="Watch full video">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M21.58 7.19a2.5 2.5 0 0 0-1.76-1.77C18.26 5 12 5 12 5s-6.26 0-7.82.42A2.5 2.5 0 0 0 2.42 7.19 26.07 26.07 0 0 0 2 12a26.07 26.07 0 0 0 .42 4.81 2.5 2.5 0 0 0 1.76 1.77C5.74 19 12 19 12 19s6.26 0 7.82-.42a2.5 2.5 0 0 0 1.76-1.77A26.07 26.07 0 0 0 22 12a26.07 26.07 0 0 0-.42-4.81zM9.75 15.02V8.98L15 12l-5.25 3.02z"/></svg>
            </button>
          </div>
        </div>
      </div>

      <!-- Hidden In-Browser Audio Player Frame -->
      <div id="ytAudioWrap" style="position:fixed;bottom:0;left:0;width:1px;height:1px;opacity:0.001;pointer-events:none;z-index:-9999;" aria-hidden="true">
        <div id="ytAudioFrame"></div>
      </div>

      <!-- Mobile Slide-Up Story Sheet -->
      <div class="story-sheet-backdrop" id="sheetBackdrop"></div>
      <div class="story-sheet" id="storySheet" aria-hidden="true">
        <div class="sheet-handle-bar"><span class="sheet-handle"></span></div>
        <div class="sheet-header">
          <div class="sheet-phase-tag" id="sheetPhaseTag">DUSK · 6:30 PM</div>
          <button class="sheet-close" id="sheetCloseBtn" type="button" aria-label="Close story sheet">×</button>
        </div>
        <h2 class="sheet-headline" id="sheetHeadline">Baraat nikli.</h2>
        <p class="sheet-body" id="sheetBody">The gate opens, the band strikes up, and a 12-minute journey immediately becomes a matter of family honour.</p>
        
        <div class="sheet-music-box">
          <div class="sheet-song-row">
            <div>
              <strong id="sheetSongTitle">Gallan Goodiyaan</strong>
              <span id="sheetSongArtist">Official video · T-Series</span>
            </div>
            <button class="sheet-yt-btn" id="sheetYtBtn" type="button">Watch Video</button>
          </div>
        </div>

        <div class="sheet-timeline-label">SEVEN PHASES OF THE BARAAT</div>
        <div class="sheet-timeline-list" id="sheetTimelineList"></div>

        <div class="sheet-actions">
          <button class="sheet-chaos-btn" id="sheetChaosBtn" type="button">+ Deploy Uncle / Boost Dhol (<span id="sheetChaosScore">18</span>% chaos)</button>
        </div>
      </div>
    </main>

    <div class="petal-layer" id="petalLayer" aria-hidden="true"></div>
    <div class="toast" id="toast" role="status" aria-live="polite"></div>

    <dialog class="modal" id="videoModal" aria-labelledby="videoModalTitle">
      <div class="modal-header">
        <div>
          <div class="modal-title" id="videoModalTitle">Gallan Goodiyaan</div>
          <div class="modal-subtitle">The baraat soundtrack · YouTube</div>
        </div>
        <button class="close-button" data-close="videoModal" aria-label="Close music player" type="button">×</button>
      </div>
      <div class="video-frame">
        <iframe id="youtubeFrame" title="Baraat soundtrack YouTube video" src="about:blank" allow="autoplay; encrypted-media; picture-in-picture; web-share" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>
      </div>
      <div class="modal-foot">
        <span>Playback starts only when you press play.</span>
        <a class="plain-link" id="youtubeLink" href="https://www.youtube.com/watch?v=jCEdTq3j-0U" target="_blank" rel="noopener noreferrer">Open on YouTube</a>
      </div>
    </dialog>

    <dialog class="modal" id="reportModal" aria-labelledby="reportModalTitle">
      <div class="modal-header">
        <div>
          <div class="modal-title" id="reportModalTitle">Official Baraat Report</div>
          <div class="modal-subtitle">Filed under: “it got out of hand”</div>
        </div>
        <button class="close-button" data-close="reportModal" aria-label="Close report" type="button">×</button>
      </div>
      <div class="report-body">
        <div class="report-score"><span id="reportScore">18</span><small> / 100 chaos</small></div>
        <div class="report-headline" id="reportHeadline">A respectable start. Suspiciously respectable.</div>
        <p class="report-copy" id="reportCopy">The band has started, people are smiling, and the DJ still believes this will finish on time.</p>
        <div class="report-stats">
          <div class="report-stat"><strong id="reportUncles">0</strong><span>Uncles deployed</span></div>
          <div class="report-stat"><strong id="reportDhol">0</strong><span>Dhol boosts</span></div>
          <div class="report-stat"><strong id="reportDJ">0</strong><span>DJ upgrades</span></div>
        </div>
        <div class="report-actions">
          <button class="action-primary" id="copyReport" type="button">Copy report</button>
          <button class="action-secondary" id="downloadReport" type="button">Save as .txt</button>
          <button class="action-secondary" id="shareReport" type="button">Share report</button>
        </div>
      </div>
    </dialog>

    <dialog class="modal" id="menuModal" aria-labelledby="menuModalTitle" style="max-width:470px">
      <div class="modal-header">
        <div>
          <div class="modal-title" id="menuModalTitle">A few baraat rules</div>
          <div class="modal-subtitle">There are no actual rules.</div>
        </div>
        <button class="close-button" data-close="menuModal" aria-label="Close menu" type="button">×</button>
      </div>
      <div class="menu-body">
        <a class="menu-row" href="/songs" style="text-decoration:none;display:flex;"><span>Explore all 140 songs<small>Complete Baraat Library across 7 phases</small></span></a>
        <a class="menu-row" href="/playlists" style="text-decoration:none;display:flex;"><span>7 Phase Rotations & Playlists<small>From Sehra Bandi to Afterparty</small></span></a>
        <a class="menu-row" href="/baraat-entry-songs-for-groom" style="text-decoration:none;display:flex;"><span>Groom Entry Songs<small>Regal, energetic, and modern selections</small></span></a>
        <a class="menu-row" href="/old-hindi-baraat-songs" style="text-decoration:none;display:flex;"><span>Old Hindi Baraat Classics<small>Golden era & 90s procession anthems</small></span></a>
        <a class="menu-row" href="/baraat-songs-for-wedding-video" style="text-decoration:none;display:flex;"><span>Wedding Video Baraat Tracks<small>Cinematic teasers and highlight songs</small></span></a>
        <a class="menu-row" href="/baraat-meaning" style="text-decoration:none;display:flex;"><span>What is a Baraat?<small>Rituals, customs, and procession history</small></span></a>
        <button class="menu-row" id="menuReport" type="button"><span>Generate your Baraat Report<small>For the group chat and the family archive</small></span></button>
        <button class="menu-row" id="resetBtn" type="button"><span>Start the baraat over<small>Everyone gets one last chance to behave</small></span><span class="menu-arrow">↻</span></button>
        <a class="menu-row" href="#baraatFooter" id="menuAboutRow" style="text-decoration:none;display:flex;"><span>About & Colophon<small>Design, story, rights & credits</small></span></a>
      </div>
    </dialog>
  </div>

  <!-- Reusable Monumental Footer with Lenis smooth scroll -->
  <PlayfollyFooter currentPath="/" />
</BaseLayout>

<script is:inline define:vars={{ songsData }}>
  window.BARAAT_DATA = songsData;
</script>

<script>
(() => {
  'use strict';
  const phases = [
    { time:'5:30 PM', title:'Sehra Bandi', hindi1:'सेहरा', hindi2:'बंदी', kicker:'PHASE 01 · EARLY EVENING · 5:30 PM', headline:'The groom is almost ready.', body:'A sehra is being adjusted for the fourth time. Someone is looking for the car keys. Phupaji has taken charge of the entire operation.', quip:'“Photo achhi aani chahiye.” Nobody is allowed to blink.', micro:'EVERYONE IS A MANAGER', image:'/assets/01-baraat-wide.png', desktopFocal:'center 36%', mobileFocal:'center 30%', song:'Ainvayi Ainvayi', artist:'Salim-Sulaiman · Sunidhi Chauhan', video:'uvf0bsywl4A', caption:'Warm-up acoustic beats and family banter before the chaos starts.', chaos:8, songs: [] },
    { time:'6:30 PM', title:'Baraat Nikli', hindi1:'बारात', hindi2:'निकली', kicker:'PHASE 02 · DUSK · 6:30 PM', headline:'Baraat nikli.', body:'The gate opens, the band strikes up, and a 12-minute journey immediately becomes a matter of family honour.', quip:'“Bas, ab seedha venue.” Famous last words.', micro:'THE PROCESSION BEGINS', image:'/assets/02-baraat-wide.png', desktopFocal:'center 36%', mobileFocal:'center 30%', song:'Gallan Goodiyaan', artist:'Shankar Mahadevan · Sukhwinder Singh · Yashita Sharma', video:'jCEdTq3j-0U', caption:'The official procession anthem; brass horns, rolling dhol, and unrestrained joy.', chaos:18, songs: [] },
    { time:'7:30 PM', title:'Pehli Gali', hindi1:'पहली', hindi2:'गली', kicker:'PHASE 03 · TWILIGHT · 7:30 PM', headline:'The road is now the dance floor.', body:'The lane is narrow, the baraat is 400 metres wide, and a scooter has become an honorary member of the procession.', quip:'“Gaadi side mein karo!” yelled by the man blocking the road.', micro:'TRAFFIC HAS JOINED THE PARTY', image:'/assets/03-baraat-wide.png', desktopFocal:'center 36%', mobileFocal:'center 30%', song:'London Thumakda', artist:'Labh Janjua · Sonu Kakkar · Neha Kakkar', video:'udra3Mfw2oo', caption:'Narrow street anthem; heavy percussions that bring every balcony to life.', chaos:35, songs: [] },
    { time:'8:30 PM', title:'Uncle Era', hindi1:'अंकल का', hindi2:'जलवा', kicker:'PHASE 04 · PRIME TIME · 8:30 PM', headline:'The uncle has taken over.', body:'He removed his jacket. He loosened one button. He has made eye contact with the DJ. There is no stopping what comes next.', quip:'The knees are 52. The confidence is 19.', micro:'CAMERAS OUT. IMMEDIATELY.', image:'/assets/04-baraat-wide.png', desktopFocal:'center 36%', mobileFocal:'center 30%', song:'Kala Chashma', artist:'Amar Arshi · Badshah · Neha Kakkar', video:'k4yXQkG2s1E', caption:'High-voltage Punjabi groove for the uncle who just loosened his tie.', chaos:54, songs: [] },
    { time:'9:30 PM', title:'DJ Ka Pralay', hindi1:'डीजे का', hindi2:'प्रलय', kicker:'PHASE 05 · NIGHT · 9:30 PM', headline:'The DJ has lost all restraint.', body:'The bass is negotiating with the power grid. Pink lights everywhere. Three cousins are doing the same move with three different levels of confidence.', quip:'“Volume aur badhao!” said from directly beside the speaker.', micro:'THE NEIGHBOURHOOD KNOWS', image:'/assets/05-baraat-wide.png', desktopFocal:'center 36%', mobileFocal:'center 30%', song:'Sauda Khara Khara', artist:'Diljit Dosanjh · Sukhbir', video:'LYEqeUr-158', caption:'Earth-shattering bass and synthesizers; volume levels decided by family consensus.', chaos:76, songs: [] },
    { time:'10:30 PM', title:'Dulhe Ki Entry', hindi1:'दूल्हे की', hindi2:'एंट्री', kicker:'PHASE 06 · LATE NIGHT · 10:30 PM', headline:'Everybody remember the groom?', body:'Phones go up. The parasol is perfectly positioned. For twelve seconds the entire family coordinates like a world-class production crew.', quip:'One cousin is still asking for the Wi-Fi password.', micro:'ALL EYES ON THE DULHA', image:'/assets/06-baraat-wide.png', desktopFocal:'center 36%', mobileFocal:'center 30%', song:'Tenu Leke', artist:'Sonu Nigam · Mahalakshmi Iyer', video:'Cu3QpWEfqgg', caption:'Triumphant entry chorus as the parasol rises and phone flashlights turn on.', chaos:68, songs: [] },
    { time:'12:00 AM', title:'Bas Ek Gaana Aur', hindi1:'बस एक गाना', hindi2:'और', kicker:'PHASE 07 · AFTER MIDNIGHT · 12:00 AM', headline:'The stove is still lit.', body:'The dhol is resting. The chai is not. A small group has discovered one more song, and the DJ has accepted the challenge personally.', quip:'“Last song pakka.” The eleventh last song.', micro:'THE NIGHT REFUSES TO END', image:'/assets/07-baraat-wide.png', desktopFocal:'center 36%', mobileFocal:'center 30%', song:'Choo Lo', artist:'The Local Train · Raman Negi', video:'sFMRqxCexDk', caption:'Mellow midnight acoustic chords for the chai stall crew who refuse to go home.', chaos:22, songs: [] }
  ];

  // Merge full 20 songs per phase from window.BARAAT_DATA
  const bData = (window as any).BARAAT_DATA;
  if (bData && Array.isArray(bData.phases)) {
    phases.forEach((p, idx) => {
      const bPhase = bData.phases[idx];
      if (bPhase && Array.isArray(bPhase.songs) && bPhase.songs.length > 0) {
        (p as any).songs = bPhase.songs;
      }
    });
  }

  const $ = (id: string) => document.getElementById(id);
  const app = $('app');
  const urlParams = new URLSearchParams(window.location.search);
  const paramPhase = parseInt(urlParams.get('phase') || '', 10);
  let currentIndex = (!isNaN(paramPhase) && paramPhase >= 0 && paramPhase < phases.length) ? paramPhase : 1;
  let currentSongInPhase = 0;

  // Pre-decode all original master phase images immediately for absolute zero-delay switching
  phases.forEach((p) => {
    const dImg = new Image();
    dImg.src = p.image;
    if (dImg.decode) dImg.decode().catch(() => {});
  });

  function getFocalPosition(phase: any) {
    if (!phase) return 'center 36%';
    const isMobile = window.innerWidth <= 860;
    return isMobile ? (phase.mobileFocal || '50% 30%') : (phase.desktopFocal || '50% 36%');
  }

  function syncSceneSources() {
    phases.forEach((p, i) => {
      const el = $(`scene-${i}`) as HTMLImageElement;
      if (!el) return;
      if (!el.src || !el.src.includes(p.image)) {
        el.src = p.image;
      }
      if (el.style) el.style.objectPosition = getFocalPosition(p);
    });
  }

  let chaos = phases[currentIndex].chaos;
  let uncles = 0, dholBoosts = 0, djUpgrades = 0;
  let lightsLow = false;
  let toastTimer: any = null;
  const youtubeUrl = (id: string) => `https://www.youtube.com/watch?v=${id}`;

  let isPlaying = false;
  let ytPlayer: any = null;
  let audioCtx: any = null;
  let synthTimer: any = null;
  let synthStep = 0;
  let silentAudio: HTMLAudioElement | null = null;

  function initAudioCtx() {
    if (!audioCtx) {
      const AC = window.AudioContext || (window as any).webkitAudioContext;
      if (AC) audioCtx = new AC();
    }
    if (audioCtx && audioCtx.state === 'suspended') {
      audioCtx.resume();
    }
    if (!silentAudio) {
      try {
        silentAudio = new Audio('data:audio/wav;base64,UklGRigAAABXQVZFZm10IBIAAAABAAEARKwAAIhYAQACABAAAABkYXRhAgAAAAEA');
        silentAudio.loop = true;
      } catch (e) {}
    }
  }

  function playDholBeat(isBass = true, accent = false) {
    if (!audioCtx) return;
    try {
      const t = audioCtx.currentTime;
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      if (isBass) {
        osc.type = 'sine';
        osc.frequency.setValueAtTime(accent ? 135 : 105, t);
        osc.frequency.exponentialRampToValueAtTime(42, t + 0.22);
        gain.gain.setValueAtTime(accent ? 0.7 : 0.5, t);
        gain.gain.exponentialRampToValueAtTime(0.001, t + 0.24);
      } else {
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(accent ? 420 : 360, t);
        osc.frequency.exponentialRampToValueAtTime(130, t + 0.1);
        gain.gain.setValueAtTime(accent ? 0.3 : 0.18, t);
        gain.gain.exponentialRampToValueAtTime(0.001, t + 0.11);
      }
      osc.connect(gain);
      gain.connect(audioCtx.destination);
      osc.start(t);
      osc.stop(t + 0.26);
    } catch (e) {}
  }

  function startBaraatSynth() {
    initAudioCtx();
    if (synthTimer) clearInterval(synthTimer);
    synthStep = 0;
    const tempo = Math.max(140, 210 - Math.round(phases[currentIndex].chaos * 0.7));
    synthTimer = setInterval(() => {
      if (!isPlaying) {
        clearInterval(synthTimer);
        synthTimer = null;
        return;
      }
      const s = synthStep % 8;
      if (s === 0) playDholBeat(true, true);
      else if (s === 2) playDholBeat(false, true);
      else if (s === 3) playDholBeat(true, false);
      else if (s === 5) playDholBeat(true, false);
      else if (s === 6) playDholBeat(false, false);
      synthStep++;
    }, tempo);
  }

  function stopBaraatSynth() {
    if (synthTimer) {
      clearInterval(synthTimer);
      synthTimer = null;
    }
  }

  function getCurrentSong(): any {
    const p: any = phases[currentIndex];
    if (p && Array.isArray(p.songs) && p.songs.length > 0) {
      if (currentSongInPhase < 0 || currentSongInPhase >= p.songs.length) {
        currentSongInPhase = 0;
      }
      return p.songs[currentSongInPhase];
    }
    return {
      titleHi: p.song,
      titleEn: p.song,
      artist: p.artist,
      film: p.title,
      duration: '4:00',
      youtubeId: p.video,
      thumbnail: p.image
    };
  }

  function formatTime(sec: number) {
    if (isNaN(sec) || sec < 0) return '0:00';
    const m = Math.floor(sec / 60);
    const s = Math.floor(sec % 60);
    return `${m}:${s < 10 ? '0' : ''}${s}`;
  }

  let progressTimer: any = null;
  function startProgressTracking() {
    if (progressTimer) clearInterval(progressTimer);
    progressTimer = setInterval(() => {
      if (!ytPlayer || typeof ytPlayer.getCurrentTime !== 'function') return;
      try {
        const cur = ytPlayer.getCurrentTime() || 0;
        const dur = ytPlayer.getDuration() || 0;
        if (dur > 0) {
          const pct = Math.min(100, Math.max(0, (cur / dur) * 100));
          if ($('trackProgressBar')) $('trackProgressBar')!.style.width = pct + '%';
          if ($('mTrackProgressBar')) $('mTrackProgressBar')!.style.width = pct + '%';
          if ($('trackProgressHandle')) $('trackProgressHandle')!.style.left = pct + '%';
          const timeStr = `${formatTime(cur)} / ${formatTime(dur)}`;
          if ($('trackTimeDisplay')) $('trackTimeDisplay')!.textContent = timeStr;
          if ($('mTrackTimeDisplay')) $('mTrackTimeDisplay')!.textContent = timeStr;
        }
      } catch (e) {}
    }, 250);
  }

  function stopProgressTracking() {
    if (progressTimer) clearInterval(progressTimer);
    progressTimer = null;
  }

  function updateMusicUI(autoLoad = false) {
    const p = phases[currentIndex];
    const s = getCurrentSong();

    const titleText = s.titleEn || s.titleHi || p.song;
    const artistText = s.artist ? `${s.artist}${s.film ? ' · ' + s.film : ''}` : p.artist;

    if ($('trackTitle')) $('trackTitle')!.textContent = titleText;
    if ($('trackArtist')) $('trackArtist')!.textContent = artistText;

    if ($('mTrackTitle')) $('mTrackTitle')!.textContent = titleText;
    if ($('mPhaseMeta')) $('mPhaseMeta')!.textContent = artistText;

    const coverUrl = s.thumbnail || (s.youtubeId ? `https://img.youtube.com/vi/${s.youtubeId}/hqdefault.jpg` : p.image);
    if ($('trackCoverImg')) ($('trackCoverImg') as HTMLImageElement).src = coverUrl;
    if ($('mTrackCoverImg')) ($('mTrackCoverImg') as HTMLImageElement).src = coverUrl;

    if ($('trackProgressBar')) $('trackProgressBar')!.style.width = '0%';
    if ($('mTrackProgressBar')) $('mTrackProgressBar')!.style.width = '0%';
    if ($('trackProgressHandle')) $('trackProgressHandle')!.style.left = '0%';
    const durStr = s.duration || '4:00';
    if ($('trackTimeDisplay')) $('trackTimeDisplay')!.textContent = `0:00 / ${durStr}`;
    if ($('mTrackTimeDisplay')) $('mTrackTimeDisplay')!.textContent = `0:00 / ${durStr}`;

    if ($('sheetSongTitle')) $('sheetSongTitle')!.textContent = titleText;
    if ($('sheetSongArtist')) $('sheetSongArtist')!.textContent = artistText;

    if ($('videoModalTitle')) $('videoModalTitle')!.textContent = `${titleText} · ${s.film || p.title}`;
    if ($('youtubeLink')) ($('youtubeLink') as HTMLAnchorElement).href = youtubeUrl(s.youtubeId);
    if ($('videoModal') && ($('videoModal') as any).open && $('youtubeFrame')) {
      ($('youtubeFrame') as HTMLIFrameElement).src = `https://www.youtube-nocookie.com/embed/${s.youtubeId}?autoplay=1&rel=0&modestbranding=1`;
    }

    if (autoLoad || isPlaying) {
      if (ytPlayer && typeof ytPlayer.loadVideoById === 'function') {
        try {
          ytPlayer.loadVideoById(s.youtubeId);
        } catch (e) {
          startBaraatSynth();
        }
      } else {
        startBaraatSynth();
      }
    }

    updateMediaSession();
  }

  function nextSong(userInitiated = true) {
    const p: any = phases[currentIndex];
    const total = (p.songs && p.songs.length) ? p.songs.length : 1;
    currentSongInPhase = (currentSongInPhase + 1) % total;
    updateMusicUI(isPlaying);
    const s = getCurrentSong();
    showToast(`♪ ${s.titleEn || s.titleHi || p.song}`);
  }

  function prevSong(userInitiated = true) {
    const p: any = phases[currentIndex];
    const total = (p.songs && p.songs.length) ? p.songs.length : 1;
    currentSongInPhase = (currentSongInPhase - 1 + total) % total;
    updateMusicUI(isPlaying);
    const s = getCurrentSong();
    showToast(`♪ ${s.titleEn || s.titleHi || p.song}`);
  }

  function initYouTubePlayer() {
    if (ytPlayer || !(window as any).YT || !(window as any).YT.Player) return;
    try {
      const s = getCurrentSong();
      const YT = (window as any).YT;
      ytPlayer = new YT.Player('ytAudioFrame', {
        height: '100',
        width: '100',
        videoId: s.youtubeId,
        playerVars: {
          autoplay: 0,
          controls: 0,
          disablekb: 1,
          fs: 0,
          rel: 0,
          modestbranding: 1,
          playsinline: 1
        },
        events: {
          onReady: () => {
            if (isPlaying) {
              try { ytPlayer.playVideo(); } catch (e) {}
            }
          },
          onStateChange: (event: any) => {
            if (event.data === YT.PlayerState.PLAYING) {
              setPlaybackState(true);
              stopBaraatSynth();
            } else if (event.data === YT.PlayerState.PAUSED) {
              setPlaybackState(false);
            } else if (event.data === YT.PlayerState.ENDED) {
              nextSong(false);
            }
          },
          onError: () => {
            if (isPlaying) startBaraatSynth();
          }
        }
      });
    } catch (e) {
      console.warn('YT audio player init', e);
    }
  }

  (window as any).onYouTubeIframeAPIReady = initYouTubePlayer;
  if ((window as any).YT && (window as any).YT.Player) {
    initYouTubePlayer();
  }

  function setPlaybackState(playing: boolean) {
    isPlaying = playing;
    const playPath = 'M8 5v14l11-7z';
    const pausePath = 'M6 19h4V5H6v14zm8-14v14h4V5h-4z';
    const path = playing ? pausePath : playPath;
    if ($('playIconSvg')) $('playIconSvg')!.querySelector('path')!.setAttribute('d', path);
    if ($('mPlayIconSvg')) $('mPlayIconSvg')!.querySelector('path')!.setAttribute('d', path);
    if ($('vinylDisc')) $('vinylDisc')!.classList.toggle('is-spinning', playing);
    if ($('mVinylDisc')) $('mVinylDisc')!.classList.toggle('is-spinning', playing);
    if ($('headerPlayBtn')) $('headerPlayBtn')!.classList.toggle('is-playing', playing);
    if (playing) {
      startProgressTracking();
    } else {
      stopProgressTracking();
    }
  }

  function toggleMusic() {
    initAudioCtx();
    isPlaying = !isPlaying;
    setPlaybackState(isPlaying);

    const s = getCurrentSong();
    const p = phases[currentIndex] || {};
    const songName = s.titleEn || s.titleHi || (p as any).song || 'Soundtrack';

    if (isPlaying) {
      if (silentAudio) {
        try { silentAudio.play(); } catch (e) {}
      }
      let ytStarted = false;
      if (ytPlayer && typeof ytPlayer.playVideo === 'function') {
        try {
          ytPlayer.playVideo();
          ytStarted = true;
        } catch (e) {}
      }
      if (!ytStarted) startBaraatSynth();
      updateMediaSession();
      showToast(`Now playing: ${songName}`);
    } else {
      if (silentAudio) {
        try { silentAudio.pause(); } catch (e) {}
      }
      if (ytPlayer && typeof ytPlayer.pauseVideo === 'function') {
        try { ytPlayer.pauseVideo(); } catch (e) {}
      }
      stopBaraatSynth();
      updateMediaSession();
      showToast('Soundtrack paused');
    }
  }

  function updateMediaSession() {
    if ('mediaSession' in navigator) {
      const p = phases[currentIndex];
      const s = getCurrentSong();
      try {
        navigator.mediaSession.metadata = new MediaMetadata({
          title: s.titleEn || p.song,
          artist: `${s.artist} · ${s.film || p.title}`,
          album: `Shadi Ki Baraat · ${p.title}`,
          artwork: [
            { src: s.thumbnail || p.image, sizes: '512x512', type: 'image/jpeg' },
            { src: p.image, sizes: '512x512', type: 'image/png' }
          ]
        });
        navigator.mediaSession.playbackState = isPlaying ? 'playing' : 'paused';
        navigator.mediaSession.setActionHandler('play', () => { if (!isPlaying) toggleMusic(); });
        navigator.mediaSession.setActionHandler('pause', () => { if (isPlaying) toggleMusic(); });
