    text-align: left;
  }

  .player-controls {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
    z-index: 1;
  }

  .player-ctrl-btn {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: none;
    background: transparent;
    color: rgba(255, 255, 255, 0.85);
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: background 0.15s, color 0.15s, transform 0.12s;
    padding: 0;
  }

  .player-ctrl-btn:hover {
    background: rgba(255, 255, 255, 0.15);
    color: #ffffff;
  }

  .player-ctrl-btn:active {
    transform: scale(0.92);
  }

  .player-play-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: none;
    background: #ffffff;
    color: #000000;
    display: grid;
    place-items: center;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
    transition: transform 0.15s, background 0.15s;
    padding: 0;
  }

  .player-play-btn:hover {
    transform: scale(1.06);
    background: #ffffff;
  }

  .player-play-btn:active {
    transform: scale(0.94);
  }

  .player-watch-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: 32px;
    padding: 0 12px;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: rgba(255, 255, 255, 0.12);
    color: #ffffff;
    font-family: var(--ui);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.18s ease;
    flex-shrink: 0;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    margin-left: 2px;
  }

  .player-watch-btn:hover {
    background: rgba(255, 255, 255, 0.26);
    border-color: rgba(255, 255, 255, 0.48);
    transform: translateY(-1px);
  }

  .player-watch-btn:active {
    transform: scale(0.96);
  }

  /* Desktop Bottom-Right Dock */
  .bottom-right-dock {
    position: absolute;
    right: clamp(16px, 2.5vw, 28px);
    bottom: clamp(16px, 2.5vw, 28px);
    z-index: 5;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 10px;
    width: min(520px, calc(50vw - 36px));
    box-sizing: border-box;
    transition: opacity .3s, transform .3s;
  }

  .bottom-right-subbar {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    box-sizing: border-box;
  }

  .dock-nav-chips {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .dock-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 26px;
    padding: 0 12px;
    border-radius: 9999px;
    font-family: var(--ui);
    font-size: 11px;
    font-weight: 500;
    text-decoration: none;
    letter-spacing: 0.01em;
    transition: all 0.18s ease;
    box-sizing: border-box;
    user-select: none;
    white-space: nowrap;
  }

  .dock-chip.active {
    background: #ffffff;
    color: #111111;
    font-weight: 600;
    border: 1px solid #ffffff;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.28);
    cursor: default;
  }

  .dock-chip:not(.active) {
    background: rgba(36, 20, 16, 0.65);
    color: rgba(255, 255, 255, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.22);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
  }

  .dock-chip:not(.active):hover {
    background: rgba(75, 36, 28, 0.85);
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.38);
    transform: translateY(-1px);
  }

  .reset-pill-inline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 26px;
    padding: 0 12px;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    background: rgba(36, 20, 16, 0.65);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    color: rgba(255, 255, 255, 0.85);
    font-family: var(--ui);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.01em;
    cursor: pointer;
    transition: all 0.18s ease;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
    white-space: nowrap;
  }

  .reset-pill-inline:hover {
    background: rgba(75, 36, 28, 0.85);
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.38);
    transform: translateY(-1px);
  }

  .timeline {
    position: relative;
    width: 100%;
    height: 86px;
    padding: 10px 20px 10px;
    border-radius: 28px;
    background: linear-gradient(90deg, rgba(62, 38, 30, 0.88) 0%, rgba(98, 48, 36, 0.85) 55%, rgba(126, 46, 32, 0.82) 100%);
    border: 1px solid rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(28px) saturate(160%);
    -webkit-backdrop-filter: blur(28px) saturate(160%);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.48), inset 0 1px 0 rgba(255, 255, 255, 0.25);
    box-sizing: border-box;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .timeline-topline {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 10px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.75);
    letter-spacing: .15em;
    text-transform: uppercase;
    margin: 0 0 6px;
    line-height: 1;
  }

  .timeline-items {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 4px;
    align-items: flex-start;
  }

  .timeline-items:before {
    content: '';
    position: absolute;
    left: 10px;
    right: 10px;
    top: 8px;
    height: 1px;
    background: rgba(255, 255, 255, 0.22);
    z-index: 0;
  }

  .phase-stop {
    z-index: 1;
    display: flex !important;
    flex-direction: column !important;
    align-items: flex-start !important;
    min-width: 0;
    text-align: left;
    background: transparent;
    border: 0;
    color: rgba(255, 255, 255, 0.65);
    padding: 0 4px;
    gap: 3px;
    cursor: pointer;
    outline: none;
    -webkit-appearance: none;
    appearance: none;
  }

  .phase-stop:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .stop-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.4);
    background: rgba(45, 22, 16, 0.85);
    margin: 4px 0 3px 4px;
    transition: all .25s;
    display: block;
  }

  .phase-time {
    font-size: 10px;
    font-weight: 500;
    white-space: nowrap;
    color: rgba(255, 255, 255, 0.72);
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
    display: block;
    margin-bottom: 2px;
  }

  .phase-name {
    font-size: 11px;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
    color: rgba(255, 255, 255, 0.88);
    line-height: 1.1;
    transition: color .2s;
  }

  .phase-stop:hover .stop-dot {
    border-color: #ffffff;
    transform: scale(1.2);
  }

  .phase-stop.is-active .stop-dot {
    width: 12px;
    height: 12px;
    margin: 2px 0 1px 2px;
    background: #ffffff;
    border-color: #e5b061;
    box-shadow: 0 0 0 3px rgba(229, 176, 97, 0.35), 0 0 14px rgba(229, 176, 97, 0.6);
  }

  .phase-stop.is-active .phase-time,
  .phase-stop.is-active .phase-name {
    color: #ffffff;
    font-weight: 700;
  }

  /* Zen Scene Mode */
  .app.zen-mode .bottom-left-dock,
  .app.zen-mode .bottom-right-dock,
  .app.zen-mode .mobile-dock {
    opacity: 0;
    pointer-events: none;
    transform: translateY(14px);
  }

  .mobile-dock { display: none; }
  .story-sheet-backdrop, .story-sheet { display: none; }

  .petal-layer { position: absolute; inset: 0; z-index: 7; pointer-events: none; overflow: hidden; }
  .petal { position: absolute; top: -35px; width: 9px; height: 13px; border-radius: 70% 20% 70% 20%; background: #efb65d; opacity: .9; animation: fall linear forwards; filter: drop-shadow(0 2px 3px rgba(0,0,0,.16)); }
  .petal:nth-child(3n) { background: #d65c63; width: 7px; height: 11px; }
  .petal:nth-child(4n) { background: #fff0c8; width: 5px; height: 8px; }
  @keyframes fall { to { transform: translate3d(var(--drift), 112vh, 0) rotate(740deg); opacity: .1; } }

  .modal {
    width: min(860px, calc(100vw - 32px));
    max-width: none;
    border: 1px solid var(--line);
    border-radius: 24px;
    padding: 0;
    color: #ffffff;
    background: rgba(14,15,18,.95);
    backdrop-filter: blur(28px);
    box-shadow: 0 25px 120px rgba(0,0,0,.65);
  }
  .modal::backdrop { background: rgba(2,4,6,.75); backdrop-filter: blur(8px); }
  .modal-header { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 20px 24px; border-bottom: 1px solid var(--line); }
  .modal-title { font-family: var(--display); font-size: 24px; font-weight: 700; line-height: 1; }
  .modal-subtitle { color: var(--dim); font-size: 11px; margin-top: 4px; }
  .close-button { border: 1px solid var(--line); background: rgba(255,255,255,.05); color: #ffffff; height: 36px; width: 36px; border-radius: 50%; display: grid; place-items: center; font-size: 18px; cursor: pointer; }
  .video-frame { aspect-ratio: 16 / 9; width: 100%; background: #050505; overflow: hidden; }
  .video-frame iframe { border: 0; width: 100%; height: 100%; display: block; }
  .modal-foot { padding: 16px 24px; display: flex; align-items: center; justify-content: space-between; gap: 12px; font-size: 11px; color: var(--dim); }
  .plain-link { color: var(--gold); text-decoration: none; }

  .report-body { padding: 24px; }
  .report-score { font-family: var(--display); font-size: clamp(48px, 6vw, 72px); font-weight: 700; line-height: .9; color: var(--gold); }
  .report-score small { font-family: var(--ui); font-size: 11px; font-weight: 600; letter-spacing: .15em; color: var(--dim); text-transform: uppercase; }
  .report-headline { font-family: var(--display); font-size: 28px; font-weight: 600; line-height: 1.15; margin: 16px 0 8px; }
  .report-copy { color: var(--muted); font-size: 13px; line-height: 1.6; max-width: 650px; }
  .report-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 24px; }
  .report-stat { border: 1px solid var(--line); border-radius: 16px; padding: 16px; background: rgba(255,255,255,.03); }
  .report-stat strong { display: block; font-family: var(--display); font-size: 24px; font-weight: 700; color: #ffffff; }
  .report-stat span { display: block; font-size: 10px; font-weight: 500; color: var(--dim); text-transform: uppercase; letter-spacing: .1em; margin-top: 4px; }
  .report-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 24px; }
  .action-primary { border: none; background: var(--gold); color: #17120c; font-weight: 600; }
  .action-secondary { border: 1px solid var(--line); background: rgba(255,255,255,.05); color: #ffffff; }
  .report-actions button { border-radius: 9999px; padding: 10px 18px; font-size: 11px; font-weight: 600; font-family: var(--ui); cursor: pointer; }

  .menu-body { padding: 16px; }
  .menu-row { display: flex; align-items: center; justify-content: space-between; padding: 16px; border-radius: 14px; border: 1px solid transparent; background: transparent; width: 100%; text-align: left; cursor: pointer; }
  .menu-row:hover { background: rgba(255,255,255,.05); border-color: var(--line); }
  .menu-row span:first-child { display: flex; flex-direction: column; gap: 4px; font-size: 13px; font-weight: 600; }
  .menu-row small { color: var(--dim); font-size: 11px; font-weight: 400; }
  .menu-arrow { color: var(--gold); font-size: 16px; }

  .toast {
    position: absolute;
    z-index: 25;
    bottom: 32px;
    left: 50%;
    transform: translate(-50%, 10px);
    padding: 10px 20px;
    color: #ffffff;
    background: rgba(14,15,18,.92);
    border: 1px solid var(--line);
    border-radius: 9999px;
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.42);
    backdrop-filter: blur(20px);
    font-size: 12px;
    font-weight: 500;
    opacity: 0;
    pointer-events: none;
    transition: opacity .24s, transform .24s;
    white-space: nowrap;
  }
  .toast.show { opacity: 1; transform: translate(-50%, 0); }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }

  @media (max-width: 1180px) {
    .site-header { padding: 18px 20px; }
    .hero-logo-wrap { top: clamp(54px, 7.5vh, 84px); }
    .hero-logo-img { width: clamp(280px, 26vw, 380px); }
    .bottom-left-dock { left: 20px; bottom: 20px; width: calc(50vw - 28px); max-width: 440px; gap: 12px; }
    .bottom-right-dock { right: 20px; bottom: 20px; width: calc(50vw - 28px); max-width: 440px; }
