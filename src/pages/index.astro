  function buildTimeline() {
    const root = $('timelineItems');
    const dotsRoot = $('mobileDots');
    const sheetRoot = $('sheetTimelineList');
    if (root) root.innerHTML = '';
    if (dotsRoot) dotsRoot.innerHTML = '';
    if (sheetRoot) sheetRoot.innerHTML = '';

    phases.forEach((phase, index) => {
      if (root) {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'phase-stop' + (index === currentIndex ? ' is-active' : '');
        button.setAttribute('role', 'tab');
        button.setAttribute('aria-selected', index === currentIndex ? 'true' : 'false');
        button.setAttribute('aria-controls', 'top');
        button.setAttribute('aria-label', `${phase.time}, ${phase.title}`);
        button.dataset.phase = String(index);
        button.innerHTML = `<span class="stop-dot"></span><span class="phase-time">${phase.time}</span><span class="phase-name">${phase.title}</span>`;
        button.addEventListener('click', () => setPhase(index));
        root.appendChild(button);
      }

      if (dotsRoot) {
        const stopBtn = document.createElement('button');
        stopBtn.type = 'button';
        stopBtn.className = 'mobile-timeline-stop' + (index === currentIndex ? ' is-active' : '');
        stopBtn.setAttribute('role', 'tab');
        stopBtn.setAttribute('aria-selected', index === currentIndex ? 'true' : 'false');
        stopBtn.setAttribute('aria-label', `${phase.title} at ${phase.time}`);
        const shortTime = phase.time.replace(/\s*PM/i, 'p').replace(/\s*AM/i, 'a').replace(/:00/g, '').toLowerCase();
        stopBtn.innerHTML = `
          <span class="mobile-timeline-dot"></span>
          <span class="mobile-timeline-time">${shortTime}</span>
        `;
        stopBtn.addEventListener('click', () => setPhase(index));
        dotsRoot.appendChild(stopBtn);
      }

      if (sheetRoot) {
        const item = document.createElement('button');
        item.type = 'button';
        item.className = 'sheet-phase-item' + (index === currentIndex ? ' is-active' : '');
        item.innerHTML = `<span><strong>${phase.title}</strong> <small style="color:rgba(255,255,255,.45);margin-left:6px">${phase.time}</small></span><span style="color:var(--gold);font-size:12px;font-family:var(--hindi)">${phase.hindi1} ${phase.hindi2}</span>`;
        item.addEventListener('click', () => {
          setPhase(index);
          closeSheet();
        });
        sheetRoot.appendChild(item);
      }
    });
  }

  let outgoingTimer: any = null;

  function setPhase(index: number) {
    if (index < 0 || index >= phases.length || index === currentIndex) return;
    const oldIndex = currentIndex;
    currentIndex = index;
    const p = phases[index];

    const oldEl = $(`scene-${oldIndex}`);
    const newEl = $(`scene-${index}`);

    if (oldEl) {
      oldEl.classList.remove('is-active');
      oldEl.classList.add('is-outgoing');
    }

    if (newEl) {
      newEl.classList.remove('is-active', 'is-outgoing');
      void newEl.offsetWidth;
      newEl.classList.add('is-active');
    }

    phases.forEach((_, i) => {
      if (i !== index && i !== oldIndex) {
        const el = $(`scene-${i}`);
        if (el) el.classList.remove('is-active', 'is-outgoing');
      }
    });

    clearTimeout(outgoingTimer);
    outgoingTimer = setTimeout(() => {
      phases.forEach((_, i) => {
        if (i !== currentIndex) {
          const el = $(`scene-${i}`);
          if (el) el.classList.remove('is-outgoing');
        }
      });
    }, 1000);

    try {
      const url = new URL(window.location.href);
      url.searchParams.set('phase', String(index));
      window.history.replaceState(null, '', url);
    } catch (e) {}

    if ($('phaseKicker')) $('phaseKicker')!.textContent = p.kicker;
    if ($('phaseHeadline')) $('phaseHeadline')!.textContent = p.headline;
    if ($('phaseBody')) $('phaseBody')!.textContent = p.body;

    if ($('sheetPhaseTag')) $('sheetPhaseTag')!.textContent = p.kicker;
    if ($('sheetHeadline')) $('sheetHeadline')!.textContent = p.headline;
    if ($('sheetBody')) $('sheetBody')!.textContent = p.body;

    document.querySelectorAll('.phase-stop').forEach((btn, i) => {
      btn.classList.toggle('is-active', i === index);
      btn.setAttribute('aria-selected', i === index ? 'true' : 'false');
    });
    document.querySelectorAll('.mobile-timeline-stop').forEach((btn, i) => {
      btn.classList.toggle('is-active', i === index);
      btn.setAttribute('aria-selected', i === index ? 'true' : 'false');
    });
    document.querySelectorAll('.sheet-phase-item').forEach((item, i) => {
      item.classList.toggle('is-active', i === index);
    });

    chaos = Math.max(chaos, p.chaos);
    updateScore();

    currentSongInPhase = 0;
    updateMusicUI(isPlaying);
  }

  function updateScore() {
    chaos = Math.max(0, Math.min(100, chaos));
    if ($('chaosLabel')) $('chaosLabel')!.textContent = `${chaos}% chaos`;
    if ($('sheetChaosScore')) $('sheetChaosScore')!.textContent = String(chaos);
  }

  function showToast(message: string) {
    const toast = $('toast');
    if (!toast) return;
    toast.textContent = message;
    toast.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => toast.classList.remove('show'), 2300);
  }

  function pulseDhol() {
    if (!app) return;
    app.classList.remove('dhol-pulse');
    void app.offsetWidth;
    app.classList.add('dhol-pulse');
    setTimeout(() => app.classList.remove('dhol-pulse'), 700);
  }

  function makePetals(count = 36) {
    const layer = $('petalLayer');
    if (!layer) return;
    layer.innerHTML = '';
    for (let i = 0; i < count; i++) {
      const petal = document.createElement('i');
      petal.className = 'petal';
      petal.style.left = `${Math.random() * 100}%`;
      petal.style.setProperty('--drift', `${Math.round(Math.random() * 260 - 130)}px`);
      petal.style.animationDuration = `${Math.random() * 3 + 3.5}s`;
      petal.style.animationDelay = `${Math.random() * 1.4}s`;
      layer.appendChild(petal);
    }
    setTimeout(() => { layer.innerHTML = ''; }, 9000);
  }

  function doAction(action: string) {
    if (action === 'uncle') {
      uncles += 1; chaos += 8;
      showToast(uncles === 1 ? 'Uncle has entered the dance floor.' : `${uncles} uncles. One dance floor. No supervision.`);
    } else if (action === 'dhol') {
      dholBoosts += 1; chaos += 12; pulseDhol();
      showToast('Dhol level increased. The windows are rattling.');
    } else if (action === 'dj') {
      djUpgrades += 1; chaos += 10; app?.classList.add('dj-lit');
      showToast('DJ upgraded. The power grid has been informed.');
    } else if (action === 'bollywood') {
      chaos = 100; djUpgrades += 1; dholBoosts += 1; makePetals(56); pulseDhol(); app?.classList.add('dj-lit');
      showToast('FULL BOLLYWOOD. Please keep your relatives inside the frame.');
    }
    updateScore();
  }

  function openSheet() {
    $('sheetBackdrop')?.classList.add('is-open');
    $('storySheet')?.classList.add('is-open');
    $('storySheet')?.setAttribute('aria-hidden', 'false');
  }
  function closeSheet() {
    $('sheetBackdrop')?.classList.remove('is-open');
    $('storySheet')?.classList.remove('is-open');
    $('storySheet')?.setAttribute('aria-hidden', 'true');
  }

  function openVideo() {
    if (isPlaying) {
      if (ytPlayer && typeof ytPlayer.pauseVideo === 'function') {
        try { ytPlayer.pauseVideo(); } catch (e) {}
      }
      stopBaraatSynth();
      setPlaybackState(false);
    }
    const s = getCurrentSong();
    const p = phases[currentIndex] || {};
    const songName = s.titleEn || (p as any).song || 'Soundtrack';
    if ($('videoModalTitle')) $('videoModalTitle')!.textContent = `${songName} · ${s.film || p.title || 'Soundtrack'}`;
    if ($('youtubeLink')) ($('youtubeLink') as HTMLAnchorElement).href = youtubeUrl(s.youtubeId);
    if ($('youtubeFrame')) ($('youtubeFrame') as HTMLIFrameElement).src = `https://www.youtube-nocookie.com/embed/${s.youtubeId}?autoplay=1&rel=0&modestbranding=1`;
    ($('videoModal') as any)?.showModal();
  }

  function openReport() {
    if ($('reportScore')) $('reportScore')!.textContent = String(chaos);
    if ($('reportUncles')) $('reportUncles')!.textContent = String(uncles);
    if ($('reportDhol')) $('reportDhol')!.textContent = String(dholBoosts);
    if ($('reportDJ')) $('reportDJ')!.textContent = String(djUpgrades);
    let headline = 'A respectable start. Suspiciously respectable.';
    if (chaos >= 90) headline = 'The baraat is now a UNESCO-level incident.';
    else if (chaos >= 70) headline = 'The DJ has assumed administrative control.';
    else if (chaos >= 45) headline = 'Uncle Sharma is now the main character.';
    else if (chaos >= 25) headline = 'The traffic police have started dancing.';
    if ($('reportHeadline')) $('reportHeadline')!.textContent = headline;
    const p = phases[currentIndex];
    if ($('reportCopy')) $('reportCopy')!.textContent = `Current stop: ${p.title} at ${p.time}. Chaos is at ${chaos}%. You deployed ${uncles} uncle${uncles === 1 ? '' : 's'}, ordered ${dholBoosts} dhol boost${dholBoosts === 1 ? '' : 's'}, and approved ${djUpgrades} DJ upgrade${djUpgrades === 1 ? '' : 's'}. The official explanation is “bas ek gaana aur.”`;
    ($('reportModal') as any)?.showModal();
  }

  function reportText() {
    return `SHADI KI BARAAT — OFFICIAL BARAAT REPORT\n\n${$('reportHeadline')?.textContent || ''}\n${$('reportCopy')?.textContent || ''}\n\nChaos: ${chaos}/100\nUncles deployed: ${uncles}\nDhol boosts: ${dholBoosts}\nDJ upgrades: ${djUpgrades}\n\nSent from Shadi Ki Baraat.`;
  }

  buildTimeline();
  syncSceneSources();

  phases.forEach((_, i) => {
    const el = $(`scene-${i}`);
    if (el) {
      el.classList.toggle('is-active', i === currentIndex);
      el.classList.remove('is-outgoing');
    }
  });

  let lastWasMobile = window.innerWidth <= 860;
  window.addEventListener('resize', () => {
    const isMobile = window.innerWidth <= 860;
    if (isMobile !== lastWasMobile) {
      lastWasMobile = isMobile;
      syncSceneSources();
    }
  });

  const initP = phases[currentIndex];
  if ($('phaseKicker')) $('phaseKicker')!.textContent = initP.kicker;
  if ($('phaseHeadline')) $('phaseHeadline')!.textContent = initP.headline;
  if ($('phaseBody')) $('phaseBody')!.textContent = initP.body;

  function updateLiveClock() {
    const now = new Date();
    const timeStr = now.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit', hour12: true }).toLowerCase();
    const el = $('headerTime');
    if (el) el.textContent = timeStr;
  }
  updateLiveClock();
  setInterval(updateLiveClock, 1000);

  updateMusicUI(false);
  updateScore();

  $('prevTrack')?.addEventListener('click', (e) => { e.stopPropagation(); prevSong(true); });
  $('nextTrack')?.addEventListener('click', (e) => { e.stopPropagation(); nextSong(true); });
  $('mPrevTrack')?.addEventListener('click', (e) => { e.stopPropagation(); prevSong(true); });
  $('mNextTrack')?.addEventListener('click', (e) => { e.stopPropagation(); nextSong(true); });
  
  $('playVideo')?.addEventListener('click', toggleMusic);
  $('mPlayTrack')?.addEventListener('click', toggleMusic);
  $('headerPlayBtn')?.addEventListener('click', toggleMusic);
  $('mTrackInfo')?.addEventListener('click', toggleMusic);

  $('watchYtBtn')?.addEventListener('click', openVideo);
  $('mWatchYtBtn')?.addEventListener('click', (e) => { e.stopPropagation(); openVideo(); });
  $('vinylWrap')?.addEventListener('click', openVideo);
  $('mVinylWrap')?.addEventListener('click', openVideo);
  $('sheetYtBtn')?.addEventListener('click', openVideo);
  $('quickResetBtn')?.addEventListener('click', () => $('resetBtn')?.click());

  function setupSeek(wrapId: string, fillId: string, handleId: string | null, timeDisplayId: string) {
    const wrap = $(wrapId);
    if (!wrap) return;
    function seekToEvent(e: any) {
      const rect = wrap!.getBoundingClientRect();
      const clientX = e.touches ? e.touches[0].clientX : e.clientX;
      const ratio = Math.max(0, Math.min(1, (clientX - rect.left) / rect.width));
      let dur = 0;
      if (ytPlayer && typeof ytPlayer.getDuration === 'function') {
        dur = ytPlayer.getDuration() || 0;
      }
      if (dur <= 0) {
        const s = getCurrentSong();
        const parts = (s.duration || '4:00').split(':');
        dur = (parseInt(parts[0], 10) || 4) * 60 + (parseInt(parts[1], 10) || 0);
      }
      const targetSec = ratio * dur;
      if (ytPlayer && typeof ytPlayer.seekTo === 'function') {
        try { ytPlayer.seekTo(targetSec, true); } catch (err) {}
      }
      const pct = (ratio * 100);
      if ($(fillId)) $(fillId)!.style.width = pct + '%';
      if (handleId && $(handleId)) $(handleId)!.style.left = pct + '%';
      if ($(timeDisplayId)) $(timeDisplayId)!.textContent = `${formatTime(targetSec)} / ${formatTime(dur)}`;
    }
    wrap.addEventListener('click', seekToEvent);
  }
  setupSeek('progressWrap', 'trackProgressBar', 'trackProgressHandle', 'trackTimeDisplay');
  setupSeek('mProgressWrap', 'mTrackProgressBar', null, 'mTrackTimeDisplay');

  $('sheetCloseBtn')?.addEventListener('click', closeSheet);
  $('sheetBackdrop')?.addEventListener('click', closeSheet);
  $('sheetChaosBtn')?.addEventListener('click', () => {
    closeSheet();
    doAction('uncle');
  });

  $('zenBtn')?.addEventListener('click', () => {
    const isZen = app?.classList.toggle('zen-mode');
    showToast(isZen ? 'Zen mode: full scene view' : 'Controls visible');
  });

  $('livePill')?.addEventListener('click', () => {
    showToast(`${$('liveCount')?.textContent} visitors celebrating live in the baraat.`);
  });
  setInterval(() => {
    const countEl = $('liveCount');
    if (countEl) {
      const current = parseInt(countEl.textContent || '148', 10) || 148;
      const delta = (Math.random() > 0.48 ? 1 : -1) * Math.floor(Math.random() * 2);
      countEl.textContent = String(Math.max(140, Math.min(160, current + delta)));
    }
  }, 5000);

  $('moodBtn')?.addEventListener('click', () => {
    lightsLow = !lightsLow;
    app?.classList.toggle('lights-low', lightsLow);
    $('moodBtn')?.setAttribute('aria-pressed', lightsLow ? 'true' : 'false');
    const icon = $('moodIcon');
    if (icon) {
      icon.innerHTML = lightsLow
        ? '<path d="M20.5 14.5A8.6 8.6 0 0 1 9.5 3.2 8.8 8.8 0 1 0 20.5 14.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>'
        : '<circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5"/><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>';
    }
  });

  $('menuBtn')?.addEventListener('click', () => ($('menuModal') as any)?.showModal());
  $('menuReport')?.addEventListener('click', () => {
    ($('menuModal') as any)?.close();
    openReport();
  });
  $('resetBtn')?.addEventListener('click', () => {
    ($('menuModal') as any)?.close();
    currentIndex = 0; chaos = phases[0].chaos; uncles = 0; dholBoosts = 0; djUpgrades = 0;
    app?.classList.remove('dj-lit','lights-low');
    lightsLow = false;
    $('moodBtn')?.setAttribute('aria-pressed','false');
    const icon = $('moodIcon');
    if (icon) icon.innerHTML = '<circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5"/><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>';
    currentIndex = 1;
    setPhase(0);
    closeSheet();
    updateScore();
    showToast('Fresh sehra. Fresh start. Same family.');
  });

  document.querySelectorAll('[data-close]').forEach(button => button.addEventListener('click', () => {
    const target = $((button as HTMLElement).dataset.close || '') as any;
    target?.close();
    if (target?.id === 'videoModal' && $('youtubeFrame')) ($('youtubeFrame') as HTMLIFrameElement).src = 'about:blank';
  }));
  $('videoModal')?.addEventListener('close', () => {
    if ($('youtubeFrame')) ($('youtubeFrame') as HTMLIFrameElement).src = 'about:blank';
  });

  $('copyReport')?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(reportText());
      showToast('Report copied. Send it to the family group.');
    } catch (e) {
      showToast('Clipboard unavailable. Use Save as .txt instead.');
    }
  });
  $('downloadReport')?.addEventListener('click', () => {
    const blob = new Blob([reportText()], {type:'text/plain;charset=utf-8'});
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'shadi-ki-baraat-report.txt';
    a.click();
    URL.revokeObjectURL(url);
  });
  $('shareReport')?.addEventListener('click', async () => {
    const data = {title:'My Shadi Ki Baraat Report', text:reportText(), url:location.href};
    if (navigator.share) {
      try { await navigator.share(data); } catch (e) {}
    } else {
      try {
        await navigator.clipboard.writeText(reportText());
        showToast('Share not available. Report copied instead.');
      } catch (e) {
        showToast('Use Copy report to share your result.');
      }
    }
  });

  document.addEventListener('keydown', (event) => {
    if (['INPUT','TEXTAREA'].includes((document.activeElement as HTMLElement)?.tagName || '')) return;
    if (($('videoModal') as any)?.open || ($('reportModal') as any)?.open || ($('menuModal') as any)?.open) {
      if (event.key === 'Escape' && ($('videoModal') as any)?.open) {
        if ($('youtubeFrame')) ($('youtubeFrame') as HTMLIFrameElement).src = 'about:blank';
      }
      return;
    }
    if (event.key === 'ArrowRight') nextSong(true);
    if (event.key === 'ArrowLeft') prevSong(true);
    if (event.key === 'ArrowUp') setPhase(Math.min(phases.length - 1, currentIndex + 1));
    if (event.key === 'ArrowDown') setPhase(Math.max(0, currentIndex - 1));
    if (event.key.toLowerCase() === 'z') {
      const isZen = app?.classList.toggle('zen-mode');
      showToast(isZen ? 'Zen mode: full scene view' : 'Controls visible');
    }
    if (event.key === 'Escape') closeSheet();
  });

  const dockAboutChip = $('dockAboutChip');
  if (dockAboutChip) {
    dockAboutChip.addEventListener('click', (e) => {
      e.preventDefault();
      const footer = $('baraatFooter');
      if (footer) {
        if ((window as any).__lenis) {
          (window as any).__lenis.scrollTo(footer, { duration: 1.4 });
        } else {
          footer.scrollIntoView({ behavior: 'smooth' });
        }
      }
    });
  }
  const menuAboutRow = $('menuAboutRow');
  if (menuAboutRow) {
    menuAboutRow.addEventListener('click', (e) => {
      e.preventDefault();
      ($('menuModal') as any)?.close();
      const footer = $('baraatFooter');
      if (footer) {
        if ((window as any).__lenis) {
          (window as any).__lenis.scrollTo(footer, { duration: 1.4 });
        } else {
          footer.scrollIntoView({ behavior: 'smooth' });
        }
      }
    });
  }
})();
</script>

<style is:global>
