---
// src/pages/baraat-entry-songs-for-groom.astro
import ArticleLayout from '../layouts/ArticleLayout.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "Baraat Entry Songs for Groom: Hindi Wedding Playlist",
      "description": "Curated Hindi groom entry songs for an unforgettable wedding arrival. Royal brass marches, high-energy dance tracks, and modern Bollywood anthems.",
      "url": "https://shadikibaraat.com/baraat-entry-songs-for-groom",
      "image": "https://shadikibaraat.com/og/og-home.jpg",
      "publisher": {
        "@type": "Organization",
        "name": "Shadi Ki Baraat",
        "url": "https://shadikibaraat.com/"
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://shadikibaraat.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Playlists",
          "item": "https://shadikibaraat.com/playlists"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Groom Entry Songs",
          "item": "https://shadikibaraat.com/baraat-entry-songs-for-groom"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the best song for a groom entry at an Indian wedding?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Top groom entry anthems include 'Azeem-O-Shaan Shahenshah' for a royal, majestic arrival, 'Tenu Leke' for a high-energy dance entry, and 'Dulhe Ka Sehra' for a heartfelt traditional procession."
          }
        },
        {
          "@type": "Question",
          "name": "How long should a groom entry song last?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The ideal duration for a groom's entry sequence is between 2.5 to 3.5 minutes. This gives enough time for the procession to reach the venue gate without losing momentum."
          }
        }
      ]
    }
  ]
};
---

<ArticleLayout
  title="Baraat Entry Songs for Groom: Hindi Wedding Playlist | Shadi Ki Baraat"
  description="Curated Hindi groom entry songs for an unforgettable wedding arrival. From royal brass entries to high-energy Bollywood dance tracks in an ad-free interface."
  badge="GROOM ARRIVAL SPECIAL"
  jsonLd={jsonLd}
>
  <header class="article-header">
    <p class="article-badge">Curated Collection · Wedding Music Guide</p>
    <h1 class="article-title">Baraat Entry Songs for the Groom</h1>
    <p class="article-lead">
      The groom's arrival sets the emotional temperature for the entire wedding night. Whether you are arriving on a decorated mare, a vintage convertible, or dancing your way through the crowd with your brothers, here are the top curated Hindi groom entry songs grouped by style. When you're ready for the full procession, you can <a href="/playlists">explore the full baraat playlist</a> across all seven phases.
    </p>
  </header>

  <!-- Group 1: Royal & Grand Entries -->
  <section class="curated-category">
    <h2 class="category-heading">1. Grand Royal Entries</h2>
    <p class="category-desc">Majestic horns, traditional shehnai, and celebratory choral anthems for a timeless regal entrance.</p>
    
    <div class="song-cards-grid">
      <article class="editorial-song-card">
        <div class="song-thumb-box">
          <img class="song-thumb-img" src="https://i.ytimg.com/vi/8uUhxTs3UUQ/hqdefault.jpg" alt="Dulhe Ka Sehra artwork" loading="lazy" />
        </div>
        <div class="song-info">
          <h3 class="song-name">Dulhe Ka Sehra</h3>
          <p class="song-artist">Nusrat Fateh Ali Khan · Dhadkan</p>
          <span class="song-vibe-tag">Classic Royal</span>
        </div>
        <button class="play-trigger-btn" data-video="8uUhxTs3UUQ" data-title="Dulhe Ka Sehra — Nusrat Fateh Ali Khan" aria-label="Play Dulhe Ka Sehra">▶</button>
      </article>

      <article class="editorial-song-card">
        <div class="song-thumb-box">
          <img class="song-thumb-img" src="https://i.ytimg.com/vi/2-7qUj3Ieeg/hqdefault.jpg" alt="Azeem-O-Shaan Shahenshah artwork" loading="lazy" />
        </div>
        <div class="song-info">
          <h3 class="song-name">Azeem-O-Shaan Shahenshah</h3>
          <p class="song-artist">Mohd Aslam · Jodhaa Akbar</p>
          <span class="song-vibe-tag">Cinematic Brass</span>
        </div>
        <button class="play-trigger-btn" data-video="2-7qUj3Ieeg" data-title="Azeem-O-Shaan Shahenshah — Jodhaa Akbar" aria-label="Play Azeem-O-Shaan Shahenshah">▶</button>
      </article>

      <article class="editorial-song-card">
        <div class="song-thumb-box">
          <img class="song-thumb-img" src="https://i.ytimg.com/vi/gve9u4vQWqI/hqdefault.jpg" alt="Mangalayam artwork" loading="lazy" />
        </div>
        <div class="song-info">
          <h3 class="song-name">Mangalayam</h3>
          <p class="song-artist">KK · O.S. Arun · Saathiya</p>
          <span class="song-vibe-tag">Sacred Chants</span>
        </div>
        <button class="play-trigger-btn" data-video="gve9u4vQWqI" data-title="Mangalayam — Saathiya" aria-label="Play Mangalayam">▶</button>
      </article>

      <article class="editorial-song-card">
        <div class="song-thumb-box">
          <img class="song-thumb-img" src="https://i.ytimg.com/vi/lff_M5j72bU/hqdefault.jpg" alt="Jashn-E-Bahaara artwork" loading="lazy" />
        </div>
        <div class="song-info">
          <h3 class="song-name">Jashn-E-Bahaara</h3>
          <p class="song-artist">Javed Ali · Jodhaa Akbar</p>
          <span class="song-vibe-tag">Sufi Elegance</span>
        </div>
        <button class="play-trigger-btn" data-video="lff_M5j72bU" data-title="Jashn-E-Bahaara — Javed Ali" aria-label="Play Jashn-E-Bahaara">▶</button>
      </article>
    </div>
  </section>

  <!-- Group 2: High-Energy Dance Arrivals -->
  <section class="curated-category">
    <h2 class="category-heading">2. High-Energy Dance Arrivals</h2>
    <p class="category-desc">Heavy Punjabi dhol drops and explosive beats when the groom enters already dancing with his squad.</p>
    
    <div class="song-cards-grid">
      <article class="editorial-song-card">
        <div class="song-thumb-box">
          <img class="song-thumb-img" src="https://i.ytimg.com/vi/Cu3QpWEfqgg/hqdefault.jpg" alt="Tenu Leke artwork" loading="lazy" />
        </div>
        <div class="song-info">
          <h3 class="song-name">Tenu Leke</h3>
          <p class="song-artist">Sonu Nigam · Salaam-E-Ishq</p>
          <span class="song-vibe-tag">Baraat Anthem</span>
        </div>
        <button class="play-trigger-btn" data-video="Cu3QpWEfqgg" data-title="Tenu Leke — Salaam-E-Ishq" aria-label="Play Tenu Leke">▶</button>
      </article>

      <article class="editorial-song-card">
        <div class="song-thumb-box">
          <img class="song-thumb-img" src="https://i.ytimg.com/vi/ktZ3TNVX7DE/hqdefault.jpg" alt="Saajanji Ghar Aaye artwork" loading="lazy" />
        </div>
        <div class="song-info">
          <h3 class="song-name">Saajanji Ghar Aaye</h3>
          <p class="song-artist">Kumar Sanu · Kuch Kuch Hota Hai</p>
          <span class="song-vibe-tag">90s Nostalgia</span>
        </div>
        <button class="play-trigger-btn" data-video="ktZ3TNVX7DE" data-title="Saajanji Ghar Aaye — KKHH" aria-label="Play Saajanji Ghar Aaye">▶</button>
      </article>

      <article class="editorial-song-card">
        <div class="song-thumb-box">
          <img class="song-thumb-img" src="https://i.ytimg.com/vi/uvf0bsywl4A/hqdefault.jpg" alt="Ainvayi Ainvayi artwork" loading="lazy" />
        </div>
        <div class="song-info">
          <h3 class="song-name">Ainvayi Ainvayi</h3>
          <p class="song-artist">Sunidhi Chauhan · Band Baaja Baaraat</p>
          <span class="song-vibe-tag">Wedding Groove</span>
        </div>
        <button class="play-trigger-btn" data-video="uvf0bsywl4A" data-title="Ainvayi Ainvayi — BBB" aria-label="Play Ainvayi Ainvayi">▶</button>
      </article>

      <article class="editorial-song-card">
        <div class="song-thumb-box">
          <img class="song-thumb-img" src="https://i.ytimg.com/vi/jCEdTq3j-0U/hqdefault.jpg" alt="Gallan Goodiyaan artwork" loading="lazy" />
        </div>
        <div class="song-info">
          <h3 class="song-name">Gallan Goodiyaan</h3>
          <p class="song-artist">Shankar Mahadevan · Dil Dhadakne Do</p>
          <span class="song-vibe-tag">Family Celebration</span>
        </div>
        <button class="play-trigger-btn" data-video="jCEdTq3j-0U" data-title="Gallan Goodiyaan — DDD" aria-label="Play Gallan Goodiyaan">▶</button>
      </article>
    </div>
  </section>

  <!-- Group 3: Contemporary & Swag Hits -->
  <section class="curated-category">
    <h2 class="category-heading">3. Contemporary & Swag Hits</h2>
    <p class="category-desc">Modern basslines, sunglasses-on swagger, and urban Punjabi bangers.</p>
    
    <div class="song-cards-grid">
      <article class="editorial-song-card">
        <div class="song-thumb-box">
          <img class="song-thumb-img" src="https://i.ytimg.com/vi/k4yXQkG2s1E/hqdefault.jpg" alt="Kala Chashma artwork" loading="lazy" />
        </div>
        <div class="song-info">
          <h3 class="song-name">Kala Chashma</h3>
          <p class="song-artist">Amar Arshi · Badshah · Baar Baar Dekho</p>
          <span class="song-vibe-tag">Prime Swag</span>
        </div>
        <button class="play-trigger-btn" data-video="k4yXQkG2s1E" data-title="Kala Chashma — Baar Baar Dekho" aria-label="Play Kala Chashma">▶</button>
      </article>

      <article class="editorial-song-card">
        <div class="song-thumb-box">
          <img class="song-thumb-img" src="https://i.ytimg.com/vi/2nK_v7k1k6s/hqdefault.jpg" alt="Ban Ja Rani artwork" loading="lazy" />
        </div>
        <div class="song-info">
          <h3 class="song-name">Ban Ja Rani</h3>
          <p class="song-artist">Guru Randhawa · Tumhari Sulu</p>
          <span class="song-vibe-tag">Smooth Charmer</span>
        </div>
        <button class="play-trigger-btn" data-video="2nK_v7k1k6s" data-title="Ban Ja Rani — Guru Randhawa" aria-label="Play Ban Ja Rani">▶</button>
      </article>

      <article class="editorial-song-card">
        <div class="song-thumb-box">
          <img class="song-thumb-img" src="https://i.ytimg.com/vi/u36p9V6R6c4/hqdefault.jpg" alt="Morni Banke artwork" loading="lazy" />
        </div>
        <div class="song-info">
          <h3 class="song-name">Morni Banke</h3>
          <p class="song-artist">Guru Randhawa · Badhaai Ho</p>
          <span class="song-vibe-tag">Dance Floor Ready</span>
        </div>
        <button class="play-trigger-btn" data-video="u36p9V6R6c4" data-title="Morni Banke — Badhaai Ho" aria-label="Play Morni Banke">▶</button>
      </article>

      <article class="editorial-song-card">
        <div class="song-thumb-box">
          <img class="song-thumb-img" src="https://i.ytimg.com/vi/uE_MpQk3z64/hqdefault.jpg" alt="Mehendi Laga Ke Rakhna artwork" loading="lazy" />
        </div>
        <div class="song-info">
          <h3 class="song-name">Mehendi Laga Ke Rakhna</h3>
          <p class="song-artist">Lata Mangeshkar · Udit Narayan · DDLJ</p>
          <span class="song-vibe-tag">Evergreen Gold</span>
        </div>
        <button class="play-trigger-btn" data-video="uE_MpQk3z64" data-title="Mehendi Laga Ke Rakhna — DDLJ" aria-label="Play Mehendi Laga Ke Rakhna">▶</button>
      </article>
    </div>
  </section>

  <!-- Practical Groom Entry Advice -->
  <section class="editorial-pro-tips">
    <h3 class="tips-title">Baraat Entry Strategy: Advice for Grooms & Planners</h3>
    <div class="tips-copy">
      <p><strong>1. Timing is everything:</strong> Aim for a 2.5 to 3.5-minute music window from the moment the car doors open or the horse halts to when you step onto the venue carpet. Longer walks fatigue the crowd; shorter entries feel rushed.</p>
      <p><strong>2. The Dhol-to-DJ Handoff:</strong> Brief your brass band and live dholis to stop exactly when the mobile DJ truck plays the primary chorus hook. A clash of live beats and recorded tracks ruins the grand entrance impact.</p>
      <p><strong>3. Keep the energy flowing:</strong> After the groom entry, transition immediately to Phase 2 (Swagat & Dhol Beats). You can <a href="/playlists" style="color:var(--gold);text-decoration:underline;">explore the full baraat playlist</a> to see how all seven phases progress seamlessly without awkward silences.</p>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="faq-section">
    <h2 class="faq-heading">Frequently Asked Questions: Groom Entry Songs</h2>
    
    <div class="faq-item">
      <h3 class="faq-q">What is the best song for a groom entry at an Indian wedding?</h3>
      <p class="faq-a">For royal, traditional entries, <em>Azeem-O-Shaan Shahenshah</em> and <em>Dulhe Ka Sehra</em> are undisputed classics. For modern, energetic entries with the groomsmen, <em>Tenu Leke</em> and <em>Kala Chashma</em> generate maximum excitement.</p>
    </div>

    <div class="faq-item">
      <h3 class="faq-q">Should groom entry songs have live dhol accompaniment?</h3>
      <p class="faq-a">Yes! A common technique is having live dholis play along with the song's primary percussive drops while the DJ manages the vocal tracks. Just ensure sound levels are balanced so vocals aren't drowned out.</p>
    </div>
  </section>
</ArticleLayout>
