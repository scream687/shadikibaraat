{
  "name": "shadikibaraat",
  "compatibility_date": "2024-09-23",
  "main": "./worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "shadikibaraat.com", "custom_domain": true },
    { "pattern": "www.shadikibaraat.com", "custom_domain": true }
  ],
  "workers_dev": false
}
